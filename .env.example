# Copy to .env.local and fill in. Never commit .env.local.

# GitHub OAuth app (git features on web/phone)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase (auth, chat, tasks, file storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never NEXT_PUBLIC_: records verified repo members for members-only repo chats
# (supabase/repo-members.sql). Supabase dashboard > Project Settings > API keys > service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (the @cocommit chat bot; server only, never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace (sk-ant-usr-…): the workspace ID (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=

# LiveKit (voice/video calls)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google sign-in has no keys in our code: enable the Google provider in the
# Supabase dashboard (Authentication > Providers) and set the redirect URLs there.
# The Google login wall is off for the demo (GitHub sign-in only); "true" turns it on.
REQUIRE_GOOGLE_LOGIN=
