{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "live-site",
  "description": "Lets the deployed site (the page the window loads) use the folder picker and the local git commands in src/git.rs, and nothing else. http://localhost:3000 is added in dev builds only (lib.rs).",
  "windows": ["main"],
  "remote": { "urls": ["https://cocommit.vercel.app/*"] },
  "permissions": [
    "dialog:allow-open",
    "allow-git-check",
    "allow-git-status",
    "allow-git-remote-url",
    "allow-git-diff",
    "allow-git-stage",
    "allow-git-unstage",
    "allow-git-discard",
    "allow-git-commit",
    "allow-git-pull",
    "allow-git-push",
    "allow-git-branches",
    "allow-git-switch"
  ]
}
